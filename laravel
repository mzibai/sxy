            margin-bottom: 24px;
            padding: 16px;
            background-color: #333538; /* 区块轻微提亮 */
            border-radius: 6px;
        }

        h3 {
            margin-top: 0;
            color: #e8e8e8;
        }

        /* a 链接样式（类似截图中的浅灰/浅蓝） */
