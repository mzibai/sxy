            border: 1px solid #000000;
            padding: 8px 10px;
            text-align: left;
        }

        table th {
            background-color: #3c3f41; /* 表头稍微加深区分 */
            color: #ffffff;
            font-weight: 600;
        }

        /* 段落 p 标签 */
        p {
            color: #d4d4d4;
            margin: 8px 0;
        }
    </style>
